<Window x:Class="Bimangle.ForgeEngine.Georeferncing.WpfProjParamCalc"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bimangle.ForgeEngine.Georeferncing"
        xmlns:models="clr-namespace:Bimangle.ForgeEngine.Georeferncing.Models"
        d:DataContext="{d:DesignInstance Type=models:ProjParamCalcModel}"
        mc:Ignorable="d"
        Title="{x:Static local:WpfProjParamCalcRes.this_Text}"
        Icon="Assets/FormGeoreferncing.ico"
        Height="360" Width="410"
        MinHeight="360" MinWidth="410"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft JhengHei UI, sans-serif"
        FontSize="12"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Loaded="WpfProjParamCalc_OnLoaded"
        Activated="WpfProjParamCalc_OnActivated">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Style="{StaticResource GridMain}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <GroupBox Grid.Row="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <!-- Row 0 -->
                <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                       Style="{StaticResource LabelForRow}"
                       Content="{x:Static local:WpfProjParamCalcRes.lblRefPointLocalCoords_Text}" />

                <!-- Row 1 -->
                <Label Grid.Row="1" Grid.Column="0"
                       Name="lblRefPointLocalY"
                       Style="{StaticResource LabelForField}"
                       Content="{x:Static local:WpfProjParamCalcRes.lblRefPointLocalY_Text}" />
                <TextBox Grid.Row="1" Grid.Column="1"
                         Name="txtRefPointLocalY"
                         Style="{StaticResource TextBoxForField}"
                         Text="{Binding RefPointLocalY, ValidatesOnDataErrors=True}" />
                <Button Grid.Row="1" Grid.RowSpan="2" Grid.Column="2"
                        Name="btnPickPositionOnModel"
                        Style="{StaticResource ButtonBig}"
                        Visibility="Hidden">
                    <TextBlock Text="{x:Static local:WpfProjParamCalcRes.btnPickPositionOnModel_Text}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </Button>

                <!-- Row 2 -->
                <Label Grid.Row="2" Grid.Column="0"
                       Name="lblRefPointLocalX"
                       Style="{StaticResource LabelForField}"
                       Content="{x:Static local:WpfProjParamCalcRes.lblRefPointLocalX_Text}" />
                <TextBox Grid.Row="2" Grid.Column="1"
                         Name="txtRefPointLocalX"
                         Style="{StaticResource TextBoxForField}"
                         Text="{Binding RefPointLocalX, ValidatesOnDataErrors=True}" />

                <!-- Row 3 -->
                <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                       Style="{StaticResource LabelForRow}"
                       Content="{x:Static local:WpfProjParamCalcRes.lblRefPointGeoCoords_Text}" />

                <!-- Row 4 -->
                <Label Grid.Row="4" Grid.Column="0"
                       Style="{StaticResource LabelForField}"
                       Content="{x:Static local:WpfProjParamCalcRes.lblRefPointGeoLat_Text}" />
                <TextBox Grid.Row="4" Grid.Column="1"
                         Name="txtRefPointGeoLat"
                         Style="{StaticResource TextBoxForField}"
                         Text="{Binding RefPointGeoLat, ValidatesOnDataErrors=True}" />
                <Button Grid.Row="4" Grid.RowSpan="2" Grid.Column="2"
                        Name="btnPickPosition"
                        Style="{StaticResource ButtonBig}"
                        Click="btnPickPosition_OnClick">
                    <TextBlock Text="{x:Static local:WpfProjParamCalcRes.btnPickPosition_Text}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </Button>

                <!-- Row 5 -->
                <Label Grid.Row="5" Grid.Column="0"
                       Style="{StaticResource LabelForField}"
                       Content="{x:Static local:WpfProjParamCalcRes.lblRefPointGeoLon_Text}" />
                <TextBox Grid.Row="5" Grid.Column="1"
                         Name="txtRefPointGeoLon"
                         Style="{StaticResource TextBoxForField}"
                         Text="{Binding RefPointGeoLon, ValidatesOnDataErrors=True}" />

            </Grid>
        </GroupBox>

        <!-- 底部按钮栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="btnOK"
                    Style="{StaticResource ButtonBigRight}"
                    IsDefault="True"
                    Click="btnOK_OnClick"
                    Content="{x:Static local:WpfProjParamCalcRes.btnOK_Text}" />
            <Button Name="btnCancel"
                    Style="{StaticResource ButtonBigRight}"
                    IsCancel="True"
                    Click="btnCancel_OnClick"
                    Content="{x:Static local:WpfProjParamCalcRes.btnCancel_Text}" />
        </StackPanel>
    </Grid>
</Window>
